# Database
DATABASE_URL="postgresql://user:password@localhost:5432/maxxed_university"

# NextAuth
NEXTAUTH_SECRET="generate-a-secure-random-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="learn@maxxedout.com"

# Video Hosting (Cloudflare Stream)
CF_STREAM_API_TOKEN="xxxxxxxx"
CF_STREAM_ACCOUNT_ID="xxxxxxxx"
CF_STREAM_SIGNING_KEY="xxxxxxxx"
CF_STREAM_CUSTOMER_CODE="xxxxxxxx"

# GoHighLevel
GHL_API_KEY="xxxxxxxx"
GHL_LOCATION_ID="xxxxxxxx"
GHL_WEBHOOK_SECRET="shared-secret-for-webhook-verification"

# Stripe (optional - if handling payments directly instead of through GHL)
STRIPE_SECRET_KEY="sk_live_xxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"

# Fanbasis
# Production base URL: https://www.fanbasis.com/public-api
# Sandbox base URL:    https://qa.dev-fan-basis.com/public-api
# (Both require the /public-api prefix despite what fanbasis docs say.)
FANBASIS_API_KEY="xxxxxxxx"
FANBASIS_BASE_URL="https://www.fanbasis.com/public-api"
# Returned ONCE when the webhook subscription is created via
# scripts/register-fanbasis-webhook.ts — store immediately in your env vault.
FANBASIS_WEBHOOK_SECRET="xxxxxxxx"

# Storage (Cloudflare R2)
R2_ACCESS_KEY_ID="xxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxx"
R2_BUCKET_NAME="maxxed-university-assets"
R2_ENDPOINT="https://xxxxxxxx.r2.cloudflarestorage.com"
