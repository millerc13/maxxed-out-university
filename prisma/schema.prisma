generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String           @id @default(cuid())
  email              String           @unique
  // Alternate emails this user can sign in with. Used when the email
  // on file is wrong (typo from a manual import, etc.) but the user
  // knows themselves by a different one. The credentials login falls
  // back to matching here if the primary email lookup misses.
  emailAliases       String[]         @default([])
  name               String?
  passwordHash       String?
  mustChangePassword Boolean          @default(false)
  image              String?
  role               Role             @default(STUDENT)
  phone              String?
  ghlContactId       String?
  emailVerified      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  accounts           Account[]
  certificates       Certificate[]
  enrollments        Enrollment[]
  progress           LessonProgress[]
  magicLinks         MagicLink[]
  passwordResetTokens PasswordResetToken[]
  sessions           Session[]
  documentSignatures DocumentSignature[]
  applications       Application[]

}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MagicLink {
  id        String    @id @default(cuid())
  token     String    @unique
  // Short SMS-friendly alias (6-char base64url, generated alongside `token`).
  // Resolved by the /a/[code] route which 302s to /auth/activate?token=<full>.
  // Nullable so legacy rows without a shortCode keep working.
  shortCode String?   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  description  String?
  shortDesc    String?
  thumbnail    String?
  previewVideo String?
  price        Int?
  published    Boolean          @default(false)
  comingSoon   Boolean          @default(false)
  isBundle     Boolean          @default(false)
  bundleId     String?
  externalUrl  String?
  // When true, the public course page shows an "Apply Now" button instead
  // of price+buy. Doesn't require externalUrl — without one, the button
  // routes to /apply/[slug] (the on-platform 5-step apply flow). With
  // externalUrl, it redirects there. Independent of `price`, which is
  // still used for any checkout that happens after the apply form.
  applyMode    Boolean    @default(false)
  // When true, the on-platform /apply/[slug] flow ends with a checkout
  // step (lead is captured in GHL first, then optional payment).
  // Funnels using this course inherit this default unless their
  // FunnelConfig.checkoutAfterApplyOverride is set.
  checkoutAfterApply Boolean    @default(false)
  // When true, /api/apply creates a GHL opportunity for this course's
  // submissions (which triggers the closer-notify automation in GHL ->
  // dashboard.maxxedout.com webhook -> closer SMS). Default true to
  // preserve current behavior; admin flips to false for QA / testing
  // a course without spamming closers.
  notifyClosersOnApply Boolean  @default(true)
  // When true, every funnel + checkout surface for this course shows a
  // "Have more questions? Book a call with a team member" CTA pointing
  // to the Calendly booking link. Default ON for every course; admin
  // can flip OFF per-course in CourseForm.
  bookACallEnabled Boolean      @default(true)
  order        Int              @default(0)
  // Catalog section + position. Null section means the course doesn't appear
  // on / or /courses (admin-only / hidden product). Both pages render from
  // these fields; the legacy price-tier classifier was removed.
  homepageSectionId String?
  homepageOrder     Int               @default(0)
  // Editable hero stat row shown on /courses/[slug]. Each entry:
  // { iconName: string, iconColor?: string, label: string }. When empty
  // the page falls back to the legacy hardcoded stats (lessons /
  // certificate / lifetime access).
  heroStats         Json              @default("[]")
  // Bullet list shown under the course thumbnail on the checkout page.
  // String[] — empty falls back to the legacy hardcoded defaults
  // (Immediate access / 1-on-1 with Todd / Certificate / Lifetime / 30d
  // refund). Edit per-course from the admin form.
  checkoutBullets   Json              @default("[]")
  // ── Delivery (post-purchase messaging) ──────────────────────────────
  // Admin-editable copy that fires when a buyer completes checkout for
  // this course. Supports {{firstName}} {{courseTitle}} {{shortUrl}}
  // {{activateUrl}} tokens. NULL → webhooks fall back to a sensible
  // default chosen by the course's apply-flow vs self-serve nature.
  welcomeSmsBody       String?  @db.Text
  welcomeEmailSubject  String?
  welcomeEmailBody     String?  @db.Text
  // When true, every successful checkout for this course also triggers
  // an automatic e-sign contract send (sendStandardEnrollmentDocument).
  // OFF by default — closers compose custom contracts for high-ticket
  // programs; admin enables only on courses where one-size-fits-all is OK.
  autoSendContract  Boolean          @default(false)
  // ── Meta Ads tracking (per-course Pixel + Conversions API) ──────────
  // metaPixelId is the Pixel/Dataset ID from Meta Events Manager (also
  // the Dataset ID for Conversions API). Sent to client-side fbq() init
  // and to CAPI server-side calls. NULL → tracking is off for this
  // course's surfaces (funnel landings, /apply, /checkout, /sign,
  // success page) — they render no Pixel script and no CAPI events.
  metaPixelId           String?
  // System User access token with `ads_management` (or at minimum
  // permission to write to the dataset). Used SERVER-SIDE only by
  // Conversions API — never serialized to the client. Generated in Meta
  // Business Suite → Settings → System Users → Generate Token.
  metaCapiAccessToken   String?
  // Optional test-event code (TEST12345 etc) from Events Manager → Test
  // Events. When set, CAPI events are tagged with this so they appear in
  // the test view and DON'T affect ad delivery. Clear to go live.
  metaTestEventCode     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  bundle            Course?          @relation("BundleChildren", fields: [bundleId], references: [id])
  childCourses      Course[]         @relation("BundleChildren")
  certificates      Certificate[]
  enrollments       Enrollment[]
  modules           Module[]
  products          ProductMapping[]
  quizzes           Quiz[]
  funnels           FunnelDeployment[]
  featuredInFunnels FunnelDeployment[] @relation("FunnelFeaturedCourses")
  promoCodes        PromoCode[]        @relation("PromoCodeCourses")
  tools             Tool[]
  homepageSection   HomepageSection? @relation(fields: [homepageSectionId], references: [id], onDelete: SetNull)
  documentSignatures DocumentSignature[]
  applications      Application[]

  @@index([bundleId])
  @@index([homepageSectionId, homepageOrder])
}

// Catalog section shown on / and /courses. Admin-curated: title,
// description, icon, and which courses belong to it. Order field controls
// the section's position on the page.
model HomepageSection {
  id          String   @id @default(cuid())
  title       String
  description String?
  iconName    String   @default("BookOpen")
  // Tailwind color class for the icon (e.g. "text-amber-500"). Optional.
  iconColor   String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]

  @@index([order])
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  courseId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Lesson {
  id            String           @id @default(cuid())
  title         String
  slug          String
  description   String?
  videoUrl      String?
  videoProvider String?          @default("cloudflare")
  videoDuration Int?
  content       String?
  order         Int              @default(0)
  isFree        Boolean          @default(false)
  isPublished   Boolean          @default(true)
  moduleId      String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]
  resources     Resource[]

  @@unique([moduleId, slug])
  @@index([moduleId])
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  fileType  String
  fileSize  Int?
  lessonId  String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Enrollment {
  id            String     @id @default(cuid())
  userId        String
  courseId      String
  enrolledAt    DateTime   @default(now())
  expiresAt     DateTime?
  source        String?
  transactionId String?
  metadata      Json?
  originalPrice Int?       // price before any promo discount (in cents)
  promoCodeId   String?
  promoCode     PromoCode? @relation(fields: [promoCodeId], references: [id])
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  completed      Boolean   @default(false)
  watchedSeconds Int       @default(0)
  lastPosition   Int       @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Certificate {
  id             String   @id @default(cuid())
  certificateId  String   @unique @default(cuid())
  userId         String
  courseId       String
  issuedAt       DateTime @default(now())
  certificateUrl String?
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([certificateId])
}

model ProductMapping {
  id             String   @id @default(cuid())
  ghlProductId   String   @unique
  ghlProductName String?
  courseId       String
  grantAll       Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([ghlProductId])
}

// Recipient list for lead/sale SMS notifications. Replaces the legacy
// path of "create GHL opportunity → mastermind webhook → closer SMS"
// for university applications. Admin manages this list at
// /admin/notifications. Set to a test number while doing QA.
model NotificationRecipient {
  id            String   @id @default(cuid())
  phone         String   // E.164 (e.g. "+19375551234")
  label         String?  // human-friendly tag, e.g. "CJ (test)" / "Closer A"
  notifyOnLead  Boolean  @default(true)
  notifyOnSale  Boolean  @default(true)
  active        Boolean  @default(true)
  // Source filter — which traffic source this recipient gets alerts for.
  // Slugs: "blueprint" | "mentorship" | "donewithyou" | "university".
  // Empty array (default) = receive from ALL sources. Non-empty = only
  // listed sources fan out to this recipient.
  sources       String[] @default([])
  // Cached after the first successful send so we don't have to
  // re-upsert the GHL contact on every notification.
  ghlContactId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Slack channel subscription. Each row = one Slack incoming webhook URL,
// scoped by which event types and traffic sources it cares about. Admin
// manages these at /admin/notifications.
//
// eventTypes: 'lead' | 'sale' | 'dd_application' | 'abandoned_checkout'
//             | 'contract_signed'. Empty array = receives nothing.
// sources:    same shape as NotificationRecipient.sources[] — empty means
//             ALL sources, non-empty means only listed sources fan out
//             to this channel. e.g. ['mentorship'] for the Mentorship
//             funnel-only channel; ['business-mentorship', 'donewithyou']
//             for the BAM channel that should accept both subdomain
//             aliases. dd_application events ignore this filter — they
//             always go to channels that opted into 'dd_application'.
model SlackChannel {
  id           String   @id @default(cuid())
  // Human-friendly label shown in admin (e.g. "DD Applications", "BAM Funnel").
  name         String
  // Optional display-only Slack channel string (e.g. "#dd-applications").
  channel      String?
  // Slack incoming webhook URL — sensitive, never serialized to client.
  webhookUrl   String
  eventTypes   String[] @default([])
  sources      String[] @default([])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Round-robin assignment counter for funnels that distribute leads
// across multiple GHL users (e.g. dd-healthcare alternates Rebecca /
// Rafael). One row per scope key. The counter is incremented + read
// transactionally inside `pickAssignee()`; assignee = candidates[counter
// % candidates.length].
model AssignmentCounter {
  id        String   @id @default(cuid())
  // Scope key — usually the funnel slug (e.g. "dd-healthcare").
  scope     String   @unique
  counter   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model WebhookLog {
  id           String   @id @default(cuid())
  source       String
  event        String
  payload      Json
  status       String
  errorMessage String?
  processedAt  DateTime @default(now())

  @@index([source, processedAt])
}

model Quiz {
  id           String        @id @default(cuid())
  title        String
  description  String?
  moduleId     String?
  courseId     String?
  passingScore Int           @default(70)
  timeLimit    Int?
  published    Boolean       @default(false)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  questions    Question[]
  course       Course?       @relation(fields: [courseId], references: [id])
  attempts     QuizAttempt[]

  @@index([moduleId])
  @@index([courseId])
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  text        String
  explanation String?
  type        QuestionType @default(MULTIPLE_CHOICE)
  points      Int          @default(1)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  answers     Answer[]
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  score       Int
  passed      Boolean
  answers     Json
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  timeSpent   Int?
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
}

model FunnelDeployment {
  id              String       @id @default(cuid())
  name            String
  url             String
  apiKey          String       @unique @default(cuid())
  subdomain       String?      @unique
  courseId        String?
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  course          Course?      @relation(fields: [courseId], references: [id])
  config          FunnelConfig?
  featuredCourses Course[]     @relation("FunnelFeaturedCourses")

  @@index([apiKey])
  @@index([subdomain])
}

model FunnelConfig {
  id                    String           @id @default(cuid())
  deploymentId          String           @unique
  headline              String?
  subheadline           String?
  bulletPoints          Json             @default("[]")
  testimonials          Json             @default("[]")
  ctaText               String?
  featureCards          Json             @default("[]")   // { title, body }[]
  forYouIf              Json             @default("[]")   // string[]
  coursesLabel          String?                            // e.g. "The Curriculum"
  coursesHeadline       String?                            // e.g. "Courses Included"
  coursesSubheadline    String?                            // e.g. "Everything you need..."
  featureCardsLabel     String?                            // e.g. "Inside This Course"
  featureCardsHeadline  String?                            // e.g. "What You'll Learn"
  featureCardsSub       String?                            // e.g. "No hype. No fluff..."
  vslVideoUrl           String?                            // hero VSL video URL or embed
  instructorImageUrl    String?                            // instructor photo URL
  bulletsLabel          String?                            // e.g. "Inside This Course"
  bulletsHeadline       String?                            // e.g. "What's Inside This Course:"
  bulletsSub            String?                            // e.g. "Everything you need to find..."
  template              String           @default("classic") // "classic" | "dark" | "bold"
  // Per-funnel override of the linked Course.checkoutAfterApply default.
  // null = inherit from course; true/false = force this funnel one way.
  checkoutAfterApplyOverride Boolean?
  updatedAt             DateTime         @updatedAt
  deployment            FunnelDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Int          // percentage (0-100) or fixed amount in cents
  maxUses       Int?         // null = unlimited
  currentUses   Int          @default(0)
  expiresAt     DateTime?
  applyToAll    Boolean      @default(true)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  courses       Course[]     @relation("PromoCodeCourses")
  enrollments   Enrollment[]

  @@index([code])
}

model PaymentProvider {
  id           String   @id @default(cuid())
  provider     String   @unique // "stripe" or "fanbasis"
  enabled      Boolean  @default(false)
  isDefault    Boolean  @default(false)
  config       Json     @default("{}")  // provider-specific config (keys stored encrypted in env)
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  MULTIPLE_SELECT
  TRUE_FALSE
}


model Tool {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  courseId     String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// Short-link redirect for prefilled checkouts. Mastermind /stage-offers
// mints these via POST /api/checkout-links so the SMS/email payload is a
// short https://university.maxxedout.com/c/<token> URL instead of a 150-char
// URL with all the prefill query params exposed.
model CheckoutLink {
  id              String    @id @default(cuid())
  token           String    @unique
  courseId        String
  email           String
  name            String?
  phone           String?
  promoCode       String?
  expiresAt       DateTime?
  clickedAt       DateTime?       // first time anyone visited the short URL
  clickCount      Int       @default(0)
  paidAt          DateTime?       // set by webhook when this link's email + course completes payment
  transactionId   String?
  sentOfferId     String?         // mastermind dashboard_sent_offers.id (cross-system reference)
  createdByEmail  String?         // who triggered the send from mastermind
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([token])
  @@index([email, courseId])
  @@index([sentOfferId])
}

// ── E-signature: contract templates + per-recipient signed documents ──
//
// `ContractTemplate` is the editable source — admin maintains it via
// /admin/documents/template. Tokens like {{Course.Name}} get
// substituted at send time. Only one row is `active` at once; the
// auto-trigger on self-checkout uses the active template.
//
// `DocumentSignature` is one row per recipient. The rendered HTML +
// markdown are SNAPSHOTTED at send time and never mutated, so a
// later template edit doesn't rewrite history. signatureHash is a
// SHA-256 over (renderedHtml + tokens + signedName + signedAt + IP),
// computed at sign time — anyone can re-derive it from the row data
// to prove tamper-evidence.
//
// Status machine: draft → sent → viewed → completed
//                              ↘ declined
//                              ↘ cancelled
// + 'expired' if signingTokenExpiresAt passes without a sign.

model ContractTemplate {
  id          String   @id @default(cuid())
  // Human-friendly name shown in admin (e.g. "Coaching Agreement v1").
  name        String
  // Markdown body. Tokens look like {{Course.Name}}, {{Customer.FirstName}},
  // {{Payment.Total}}, {{Payment.Schedule}}. Admin edits this in the UI.
  body        String   @db.Text
  // List of token names used by the body, declared so the admin compose
  // form knows which fields to expose. Example: ["Course.Name", "Payment.Total"].
  tokens      Json     @default("[]")
  // Only one template can be active at a time — the auto-trigger uses it.
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // For audit — who edited it last.
  lastEditedById String?

  signatures  DocumentSignature[]

  @@index([active])
}

model DocumentSignature {
  id              String   @id @default(cuid())

  // ── Recipient identity ─────────────────────────────────────
  // userId is nullable so admins can fire docs to non-User emails
  // (off-list custom deals). recipientEmail is always set.
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientEmail  String
  recipientName   String?
  recipientPhone  String?

  // ── What the doc is for ────────────────────────────────────
  // courseId is nullable so admins can fire generic / off-catalog
  // docs. courseTitle is a snapshot so course renames don't
  // rewrite history.
  courseId        String?
  course          Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseTitle     String

  // ── Template + content ─────────────────────────────────────
  contractTemplateId String
  contractTemplate ContractTemplate @relation(fields: [contractTemplateId], references: [id])
  // Token values that were substituted (audit trail / reproducibility).
  tokens          Json
  // Verbatim rendered HTML at the moment of send — never mutated, even
  // if the source template later changes. The canonical "what they signed"
  // record.
  renderedHtml    String   @db.Text
  // Verbatim rendered markdown (for re-rendering / re-export).
  renderedMarkdown String  @db.Text

  // ── State machine ──────────────────────────────────────────
  status          String   @default("draft")
  origin          String   // 'auto_self_checkout' | 'manual_admin'

  // ── Signing security ───────────────────────────────────────
  // 32-byte hex token used in the /sign/[token] URL. Cleared on
  // sign / cancel / expire — one-time-use.
  signingToken    String?  @unique
  signingTokenExpiresAt DateTime?

  // ── Snapshot of payment context ────────────────────────────
  paymentTotalCents Int?
  paymentPlan     Json?

  // ── Free-text admin notes ──────────────────────────────────
  // Optional context the admin typed in the Compose form (special
  // terms agreed by phone, why this is being sent, etc.). Surfaced
  // in /admin/documents and also substituted into the contract via
  // the {{Notes}} token.
  notes           String?  @db.Text

  // ── Tamper-evidence hash ───────────────────────────────────
  // SHA-256 of: renderedHtml + JSON.stringify(tokens) + signedName +
  // signedAt.toISOString() + signedFromIp. Stored at signing time.
  signatureHash   String?

  // ── Audit trail (append-only JSON array) ───────────────────
  auditEvents     Json     @default("[]")

  // ── Captured at signing ────────────────────────────────────
  signedName      String?
  signedAt        DateTime?
  signedFromIp    String?
  signedFromUa    String?  @db.Text
  signedFromTz    String?
  signedScreenW   Int?
  signedScreenH   Int?
  // PNG data URL of the actual signature mark — either a stylized
  // type-to-sign render OR a finger/mouse-drawn canvas image. Null
  // means we fall back to the typed name in cursive font (legacy
  // path). Included in signatureHash so it's tamper-evident.
  signedSignaturePng String? @db.Text
  // 'typed' | 'drawn' — how the signedSignaturePng was produced.
  // Surfaces in the audit trail and the admin viewer.
  signedSignatureMode String?

  // ── Other lifecycle timestamps ─────────────────────────────
  sentAt          DateTime?
  firstViewedAt   DateTime?
  declinedAt      DateTime?
  cancelledAt     DateTime?

  // ── PDF cache pointer ──────────────────────────────────────
  // R2 object key once generated. null until first download.
  pdfR2Key        String?
  pdfGeneratedAt  DateTime?

  // ── Provenance ─────────────────────────────────────────────
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Who triggered a manual send (null for auto).
  createdByUserId String?
  // For auto-send, the Enrollment that triggered this.
  enrollmentTransactionId String?

  @@index([status])
  @@index([recipientEmail])
  @@index([userId])
  @@index([courseId])
  @@index([createdAt])
}

// Course application — written when a buyer completes the on-platform
// /apply/[slug] form (or the same form on a funnel subdomain). One row
// per (email, courseId) — re-submitting from the same email + course
// updates the existing row instead of creating a duplicate. Drives:
//   · the "Application submitted" success state on /courses/[slug]
//   · the apply route gate (already-applied users get redirected to
//     /courses/[slug]?applied=1 instead of being shown the form again)
// Lives separately from Enrollment because applying ≠ owning the
// course — the high-ticket flow has a closer review step in between.
model Application {
  id          String   @id @default(cuid())
  // Linked to the User row when the applicant is logged in or has an
  // account by the same email. Nullable so funnel applies (where the
  // user may not exist on the university yet) still write a row.
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email       String
  name        String?
  phone       String?
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Where the apply form lived: "university" (on-platform) or
  // "blueprint" / "mentorship" / "donewithyou" / "accelerator" / etc.
  // for funnel subdomains. Useful for analytics + debugging.
  source      String   @default("university")
  // Free-form payload of additional fields collected by the wizard
  // (vision, biggest obstacle, current stage, etc.). Schema is owned
  // by /lib/apply-schema.ts; we store the raw answers for closer review.
  payload     Json     @default("{}")
  // GHL contact id resolved at submit time so we can re-link to the
  // CRM record without re-querying GHL.
  ghlContactId String?
  // Lifecycle: submitted → reviewed → enrolled → declined / cancelled
  status      String   @default("submitted")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([email, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}
